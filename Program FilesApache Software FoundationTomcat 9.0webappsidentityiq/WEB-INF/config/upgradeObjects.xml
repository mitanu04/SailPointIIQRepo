                <ColumnConfig headerKey="cert_item_tbl_header_identity" dataIndex="Identity-displayName" hideable="true" hidden="true" property="Identity.displayName" sortProperty="Identity.displayName" sortable="true"/>
                <ColumnConfig headerKey="manager" dataIndex="Identity-manager-displayName" hideable="true" hidden="true" property="Identity.manager.displayName" sortProperty="Identity.manager.displayName" sortable="true"/>
                <ColumnConfig headerKey="cert_item_tbl_header_accountid" dataIndex="nativeIdentity" property="exceptionEntitlements.nativeIdentity" sortable="true" hideable="true" hidden="true" secondarySort="exceptionApplication,parent.lastname,parent.firstname,type,IIQ_displayName" />
                <ColumnConfig headerKey="cert_item_tbl_header_instance" dataIndex="instance" property="exceptionEntitlements.instance" sortable="true" hideable="true" hidden="true" secondarySort="exceptionApplication,parent.lastname,parent.firstname,type,IIQ_displayName"/>
                <ColumnConfig headerKey="cert_item_tbl_header_account" dataIndex="IIQ_accountKey" property="IIQ_accountKey" sortable="true" hideable="true" hidden="true" sortProperty="exceptionEntitlements.displayName,exceptionApplication,exceptionEntitlements.instance" secondarySort="parent.lastname,parent.firstname,type,IIQ_displayName" groupProperty="exceptionApplication,exceptionEntitlements.nativeIdentity,exceptionEntitlements.instance" renderer="certItemAccount" evaluator="sailpoint.web.view.certification.CertificationItemAccountKeyColumn" />
                <ColumnConfig headerKey="cert_item_tbl_header_attribute" dataIndex="exceptionAttributeName"  property="exceptionAttributeName" sortable="true" hideable="true" secondarySort="parent.lastname,parent.firstname,type,IIQ_displayName"/>
