   <ImportAction name='merge'>
    <Configuration name='IdentitySelectorConfiguration'>
      <Attributes>
        <Map>
          <entry key="identityFilters">
            <value>
              <Map>
                <entry key="RoleOwner">
                  <value>
                    <IdentityFilter name="RoleOwner">
                      <IncludedFilterReferences>
                        <String>IncludeWorkGroups</String>
                      </IncludedFilterReferences>
                      <FilterSrc>
                        <FilterSource>
                          <BasicFilter>
                            <Filter operation="JOIN" property="id" joinProperty="Bundle.owner.id"/>
                          </BasicFilter>
                        </FilterSource>
                      </FilterSrc>
                      <OrderBy>
                        <String>firstname</String>
                        <String>lastname</String>
                        <String>name</String>
                        <String>id</String>
                      </OrderBy>
