        <Argument name='context'>
          <Description>
            A sailpoint.api.SailPointContext.
          </Description>
        </Argument>
        <Argument name="identity">
          <Description>
            The identity to evaluate
          </Description>
        </Argument>
      </Inputs>
    </Signature>
    <Source>
      <![CDATA[
      // always return false
      return false;
    ]]>
