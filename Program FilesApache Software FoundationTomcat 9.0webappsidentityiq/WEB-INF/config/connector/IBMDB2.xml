    <Menu name="DB2 Configuration" label="con_form_db2_server_settings">
        <Section name="DB2 Configuration" label="con_form_db2_server_settings" sectionInfo="sectionInfo_Credentials"
        docLinkLabel="docLinkLabel_db2Settings" docLink="https://documentation.sailpoint.com/connectors/ibm/ibm_db2/help/">
			<Field name="url" displayName="con_form_db2_server_url" type="text" required="true"
				defaultValue="jdbc:db2://&lt;server&gt;:&lt;port&gt;/&lt;database name&gt;" helpKey="con_form_db2_server_url_help" />
         	<Field name="user" displayName="con_form_db2_server_user" type="text" required="true"
				defaultValue="&lt;login name&gt;" helpKey="con_form_db2_server_user_help" />
         	<Field name="password" displayName="con_form_db2_server_password" type="secret" required="true"
				helpKey="con_form_db2_server_password_help" />
         	<Field name="driverClass" displayName="con_form_db2_server_driver" type="text" required="true"
				defaultValue="com.ibm.db2.jcc.DB2Driver" helpKey="con_form_db2_server_driver_help" />
      </Section>
    </Menu>
</Form>]]>
      </Settings>
    </Application>
</ImportAction>