<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ImportAction PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<ImportAction name="connectorRegistryUpdateAction">
    <Application connector="sailpoint.connector.OpenConnectorAdapter"
                 featuresString="PROVISIONING, SYNC_PROVISIONING, ENABLE" icon="internetIcon" name="SAP Identity Directory"
                 type="SAP Identity Directory">
        <Attributes>
            <Map>
                <entry key="connectorClass" value="openconnector.connector.sapidentitydirectory.SAPIdentityDirectoryConnector"/>
                <entry key="encrypted" value="scim0_password, oauth_token_info"/>
                <entry key="pageSize" value="100"/>
                <entry key="authType" value="Basic"/>
                <entry key="appTemplateData"
                       value="{'whiteListedAttributes': ['cloudDisplayName', 'cloudExternalId', 'jsonPathMapping', 'connTimeout', 'connectionType', 'connectorClass', 'connectorName', 'deleteThresholdPercentage', 'pageSize', 'usePatch', 'skipGrpUpdate', 'relaxConfiguration', 'authType', 'sourceDescription', 'sourceConnected', 'templateApplication', 'status', 'since', 'beforeProvisioningRule', 'healthCheckTimeout', 'healthy', 'formPath']}"/>
                <entry key="relaxConfiguration" value="true"/>
                <entry key="scim0_usePatch" value="true"/>
                <entry key="formPath" value="SAPIdentityDirectoryForm.xhtml"/>
                <entry key="provisionMultivaluedRFCCompatible">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry>
            </Map>
        </Attributes>
        <Schemas>
            <Schema displayAttribute="User Name" identityAttribute="ID" nativeObjectType="User"
                    objectType="account">
                <AttributeDefinition name="ID" type="string" internalName="id">
                    <Description>A unique identifier for the user.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="External ID" type="string" internalName="externalId">
                    <Description>An Identifier for the user as defined by the provisioning client.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Active" type="boolean" internalName="active">
                    <Description>A Boolean value indicating the Users administrative status.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="User Name" type="string" internalName="userName">
                    <Description>The user name used by the user to directly authenticate to the service provider.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="User Type" type="string" internalName="userType">
                    <Description>The type of user used to identify the relationship between the organization and the user.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="First Name" type="string" internalName="name.givenName">
                    <Description>The given name of the User, or first name in most Western languages.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Last Name" type="string" internalName="name.familyName">
                    <Description>The family name of the User, or last name in most Western languages.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Middle Name" type="string" internalName="name.middleName">
                    <Description>The middle name of the User.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Salutation" type="string" internalName="name.honorificPrefix">
                    <Description>A formal title used before the user's name.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Display Name" type="string" internalName="displayName">
                    <Description>The name of the User, suitable for display to end-users.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Title" type="string" internalName="title">
                    <Description>The users title, such as Vice President.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Language" type="string" internalName="preferredLanguage">
                    <Description>The user's preferred written or spoken language.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Locale" type="string" internalName="locale">
                    <Description>The user's locale.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Timezone" type="string" internalName="timezone">
                    <Description>The Users time zone in the Olson time zone database format, e.g., America/Los_Angeles.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Email" type="string" internalName="emails.work.primary.value">
                    <Description>The user's primary email address.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Phone" type="string" internalName="phoneNumbers.work.primary.value">
                    <Description>The user's primary work phone number.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Street Address" type="string"
                                     internalName="addresses.work.primary.streetAddress">
                    <Description>The user's street address.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Locality" type="string"
                                     internalName="addresses.work.primary.locality">
                    <Description>Locality used in street address.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Region" type="string"
                                     internalName="addresses.work.primary.region">
                    <Description>Region used in street address.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Postal Code" type="string"
                                     internalName="addresses.work.primary.postalCode">
                    <Description>Postal code used in street address.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Country" type="string"
                                     internalName="addresses.work.primary.country">
                    <Description>Country used in street address.</Description>
                </AttributeDefinition>

                <!-- Enterprise schema attributes -->
                <AttributeDefinition name="Manager" type="string" internalName="manager.value">
                    <Description>The user's primary supervisor username.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Cost Center" type="string" internalName="costCenter">
                    <Description>The user's cost center.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Division" type="string" internalName="division">
                    <Description>The user's division.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Organization" type="string" internalName="organization">
                    <Description>The user's organization name.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Department" type="string" internalName="department">
                    <Description>The user's department.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Employee Number" type="string" internalName="employeeNumber">
                    <Description>A Numeric or alphanumeric identifier assigned to a person, typically based on order of hire or association with an organization.</Description>
                </AttributeDefinition>

                <!-- SAP User schema attributes -->
                <AttributeDefinition name="Relationship" type="string" internalName="companyRelationship">
                    <Description>The user's association with the organization.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Source System" type="string" internalName="sourceSystem">
                    <Description>The password authentication provider type.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Source System ID" type="string" internalName="sourceSystemId">
                    <Description>The password authentication provider ID.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Industry" type="string" internalName="industry">
                    <Description>The user's industry.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="User ID" type="string" internalName="userId">
                    <Description>The user's ID.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="SAP User Name" type="string" internalName="sapUserName">
                    <Description>The user's SAP user name.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="User UUID" type="string" internalName="userUuid">
                    <Description>The user's unique identification number.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Corporate Group" type="string" multi="true" internalName="corporateGroups">
                    <Description>A list of user's corporate groups.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Is Email Verified?" type="string" internalName="mailVerified">
                    <Description>A boolean value indicating user email vefification status.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Password Status" type="string" internalName="passwordDetails.status">
                    <Description>The user's password status.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Password Policy" type="string" internalName="passwordDetails.policy">
                    <Description>The user's password policy.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Valid From" type="string" internalName="validFrom">
                    <Description>The user's valid from date.</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Valid To" type="string" internalName="validTo">
                    <Description>The user's valid to date.</Description>
                </AttributeDefinition>

                <!-- Group attribute -->
                <AttributeDefinition entitlement="true" internalName="groups" managed="true" multi="true" name="Groups"
                                     schemaObjectType="group" type="string">
                    <Description>A list of groups to which the user belongs.</Description>
                </AttributeDefinition>

            </Schema>
            <Schema descriptionAttribute="Description" displayAttribute="Display Name" identityAttribute="ID"
                    instanceAttribute="" nativeObjectType="group" objectType="group">
                <AttributeDefinition name="ID" type="string" internalName="id" >
                    <Description>A unique identifier for the group</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Display Name" type="string" internalName="displayName">
                    <Description>The group's name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Description" type="string" internalName="description">
                    <Description>The group's description</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Members" type="string" internalName="members.value" multi="true" >
                    <Description>The members of the group</Description>
                </AttributeDefinition>
            </Schema>
        </Schemas>
        <Templates>
            <Template name="Create" schemaObjectType="account" usage="Create">
                <Field displayName="con_prov_policy_user_create_identity_directory_user_name"
                       helpKey="help_con_prov_policy_user_create_identity_directory_user_name" name="User Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_identity_directory_first_name"
                       helpKey="help_con_prov_policy_user_create_identity_directory_first_name" name="First Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_identity_directory_last_name"
                       helpKey="help_con_prov_policy_user_create_identity_directory_last_name" name="Last Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_identity_directory_display_name"
                       helpKey="help_con_prov_policy_user_create_identity_directory_display_name" name="Display Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_identity_directory_email"
                       helpKey="help_con_prov_policy_user_create_identity_directory_email" name="Email"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_identity_directory_user_type"
                       helpKey="help_con_prov_policy_user_create_identity_directory_user_type"
                       name="User Type" reviewRequired="true" type="string">
                    <AllowedValuesDefinition>
                        <Value>
                            <List>
                                <String>employee</String>
                                <String>public</String>
                                <String>partner</String>
                                <String>customer</String>
                                <String>external</String>
                                <String>onboardee</String>
                            </List>
                        </Value>
                    </AllowedValuesDefinition>
                </Field>
            </Template>
        </Templates>
        <Settings><![CDATA[<?xml version='1.0' encoding='UTF-8'?>
<!-- Copyright (C) 2024 SailPoint Technologies","Inc. All rights reserved. -->

<Form xmlns='http://www.sailpoint.com/xsd/sailpoint_form_2_0.xsd' name='SAP Identity Directory' connectorName="SAP Identity Directory"
	type="SourceConfig" directConnect="true" status="released" shortDesc="ShortDesc">

	<Menu name="SAP Identity Directory Connection Settings" label="con_form_sap_identity_directory_connection_settings">
		<Section name="SAP Identity Directory Connection Settings" label="con_form_sap_identity_directory_connection_settings">
			<Field name="scim0_host" displayName="con_form_sap_identity_directory_application_url" type="text" required="true"
				helpKey="help_con_form_sap_identity_directory_application_url" />
			<Field name="scim0_authType" displayName="con_form_sap_identity_directory_authentication_method" type="select"
				required="true" defaultValue="Basic"  helpKey="help_con_form_sap_identity_directory_authentication_method">
				<AllowedValues>
					<Option label="Basic" value="Basic"/>
				</AllowedValues>
			</Field>
			<Field name="scim0_user" displayName="con_form_sap_identity_directory_client_id" type="text" required="true"
				helpKey="help_con_form_sap_identity_directory_user"/>
			<Field name="scim0_password" displayName="con_form_sap_identity_directory_client_secret" type="secret" required="true"
				helpKey="help_con_form_sap_identity_directory_password" />
		</Section>
	</Menu>
	<Menu name="Page Size Settings" label="con_form_sap_identity_directory_page_size_settings">
		<Section name="Page Size Settings" label="con_form_sap_identity_directory_page_size_settings">
			<Field name="pageSize" displayName="con_form_sap_identity_directory_page_size" type="number"
			defaultValue="100" min="1" max="500" helpKey="help_con_form_sap_commerce_cloud_page_size_settings"/>
		</Section>
	</Menu>
</Form>]]>
        </Settings>
    </Application>
</ImportAction>
