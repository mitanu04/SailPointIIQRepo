		          	<Option label="con_form_ukgpro_select_on_strike" value="On strike"/>
		          	
		          	<Option label="con_form_ukgpro_select_released_laid" value="Released/laid off"/>
		          	<Option label="con_form_ukgpro_select_suspended" value="Suspended"/>
	        	</AllowedValues>
