                    <Option label="con_form_ukgpro_basic_auth" value="BasicAuthentication"/>
                </AllowedValues>
            </Field>
            <!-- Fields for 'BasicAuthentication -->
            <Field name="username" displayName="con_form_ukgpro_username" type="text" required="true"
            helpKey="help_con_form_ukgpro_username"/>
            <Field name="password" displayName="con_form_ukgpro_password" type="secret" required="true"
            helpKey="help_con_form_ukgpro_password"/>
            <Field name="customerApiKey" displayName="con_form_ukgpro_customer_api_key" type="secret" required="true"
            helpKey="help_con_form_ukgpro_customer_api_key"/>
