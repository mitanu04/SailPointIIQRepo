<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ImportAction PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<ImportAction name="connectorRegistryUpdateAction">
    <Application connector="sailpoint.connector.OpenConnectorAdapter"
                 featuresString="PROVISIONING, SYNC_PROVISIONING" icon="internetIcon" name="SAP Analytics Cloud"
                 type="SAP Analytics Cloud">
        <Attributes>
            <Map>
                <entry key="connectorClass" value="openconnector.connector.sapanalyticscloud.SACConnector"/>
                <entry key="encrypted" value="ips0_password"/>
                <entry key="pageSize" value="100"/>
                <entry key="ips0_authType" value="Basic"/>
                <entry key="relaxConfiguration" value="true"/>
                <entry key="formPath" value="SACAttributesForm.xhtml"/>
                <entry key="includeExtendedSchemaUrnInSchemasList">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry >
                <entry key="updateGroupsViaUsers">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry>
            </Map>
        </Attributes>
        <Schemas>
            <Schema displayAttribute="User Name" identityAttribute="ID" nativeObjectType="User"
                    objectType="account">
                <AttributeDefinition name="ID" type="string" internalName="id">
                    <Description>A unique identifier for the user</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Active" type="string" internalName="active">
                    <Description>The user's active status</Description>
                </AttributeDefinition>
                <AttributeDefinition name="User Name" type="string" internalName="userName">
                    <Description>The user's login name or user name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="First Name" type="string" internalName="name.givenName">
                    <Description>The user's first name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Last Name" type="string" internalName="name.familyName">
                    <Description>The user's last name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Display Name" type="string" internalName="displayName">
                    <Description>The user's display name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Email" type="string" internalName="emails.work.primary.value">
                    <Description>The user's work email address</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Manager ID" type="string" internalName="manager.value">
                    <Description>The user's primary supervisor username</Description>
                </AttributeDefinition>
                <AttributeDefinition name="External ID" type="string" internalName="externalId">
                    <Description>An identifier for the resource as defined by the provisioning client</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Roles" type="string" internalName="roles" multi="true" entitlement="true" managed="true" schemaObjectType="role">
                    <Description>The user's Role assignments</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Groups" type="string" internalName="groups" multi="true" entitlement="true" managed="true" schemaObjectType="group">
                    <Description>Groups linked to the user through role assignments</Description>
                </AttributeDefinition>
            </Schema>
            <Schema displayAttribute="Role Value" identityAttribute="Role Value" nativeObjectType="group"
                    objectType="role">
                <AttributeDefinition name="Role Value" internalName="roles.value" type="string">
                    <Description>A unique value for the role</Description>
                </AttributeDefinition>
            </Schema>
            <Schema displayAttribute="Group Name" identityAttribute="ID" objectType="group" nativeObjectType="group">
                <AttributeDefinition name="ID" internalName="id" type="String">
                    <Description>A unique identifier for the group</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Group Name" internalName="displayName" required="true" type="String">
                    <Description>The group's name</Description>
                </AttributeDefinition>
                <AttributeDefinition name="Roles" internalName="roles" required="true" type="string" multi="true"
                                     schemaObjectType="role">
                    <Description>The roles associated with the group</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="members.value" multi="true" name="Members" type="string">
                    <Description>The members of the group</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="description" name="Description" type="string">
                    <Description>The group's description</Description>
                </AttributeDefinition>
            </Schema>
        </Schemas>
        <Templates>
            <Template name="Create" schemaObjectType="account" usage="Create">
                <Field displayName="con_prov_policy_user_create_sac_user_name"
                       helpKey="help_con_prov_policy_user_create_sac_user_name" name="userName"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_sac_first_name"
                       helpKey="help_con_prov_policy_user_create_sac_first_name" name="name.givenName"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_sac_last_name"
                       helpKey="help_con_prov_policy_user_create_sac_last_name" name="name.familyName"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_sac_display_name"
                       helpKey="help_con_prov_policy_user_create_sac_display_name" name="displayName"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_sac_email"
                       helpKey="help_con_prov_policy_user_create_sac_email" name="emails.work.primary.value"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_sac_manager_id"
                       helpKey="help_con_prov_policy_user_create_sac_manager_id" name="manager.value"
                       reviewRequired="true" type="string"/>
            </Template>
        </Templates>
        <Settings><![CDATA[<?xml version='1.0' encoding='UTF-8'?>
<!-- Copyright (C) 2024 SailPoint Technologies, Inc.  All rights reserved. -->
<Form xmlns='http://www.sailpoint.com/xsd/sailpoint_form_2_0.xsd'
      name='SAP Analytics Cloud' connectorName="SAP Analytics Cloud"
      shortDesc="con_form_sac_connection_settings" type="SourceConfig" directConnect="true" status="released" fileUpload="false">

    <!-- Connection Settings -->
    <Menu name="SAP IPS Connection Settings" label="con_form_sac_ips_connection_settings">
        <!-- IPS configuration -->

        <Section name="SAP IPS Connection Settings" label="con_form_sac_ips_connection_settings"
                 sectionInfo="con_form_sac_ips_connection_settings" docLinkLabel="docLinkLabel_AuthenticationSettings"
                 docLink="https://documentation.sailpoint.com/connectors/sap/analytics_cloud/help/">
            <Field name="ips0_host" displayName="con_form_sac_ips_proxy_host" type="url" required="true" helpKey="help_con_form_sac_ips_proxy_host"
            requiredMessage="con_prov_host_url_not_null"/>
            <Field name="ips0_proxySystemId" displayName="con_form_sac_ips_proxy_system_id"
             type="text" required="true" helpKey="help_con_form_sac_ips_proxy_system_id"
             requiredMessage="con_prov_ips_proxy_system_id_not_null"/>
            <Field name="ips0_user" displayName="con_form_sac_ips_client_id" type="text" required="true" helpKey="help_con_form_sac_ips_client_id"
            requiredMessage="con_prov_client_id_not_null"/>
            <Field name="ips0_password" displayName="con_form_sac_ips_client_secret" type="secret" required="true" helpKey="help_con_form_sac_ips_client_secret"
            requiredMessage="con_prov_client_secret_not_null"/>
        </Section>
    </Menu>

    
    <Menu name="Page Size Settings" label="con_form_sac_page_size_settings">
        <!-- Page size settings -->
        <Section name="Page Size Settings"
                 label="con_form_sac_page_size_settings"
                 sectionInfo="con_form_sac_page_size_settings">
            <Field name="pageSize" displayName="con_form_sac_page_size" type="number"
             saveAsString="true" defaultValue="100" min="10" max="100" helpKey="help_con_form_sac_page_size_settings"/>
        </Section>
    </Menu>
</Form>]]>
        </Settings>
    </Application>
</ImportAction>