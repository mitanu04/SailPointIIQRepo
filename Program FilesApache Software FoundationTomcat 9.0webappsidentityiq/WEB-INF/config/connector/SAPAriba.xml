<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ImportAction PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<ImportAction name="connectorRegistryUpdateAction">
    <Application connector="sailpoint.connector.OpenConnectorAdapter"
                 featuresString="PROVISIONING, SYNC_PROVISIONING, ENABLE" icon="internetIcon" name="SAP Ariba"
                 type="SAP Ariba">
        <Attributes>
            <Map>
                <entry key="connectorClass" value="openconnector.connector.sapariba.SAPAribaConnector"/>
                <entry key="encrypted" value="ips0_password, rest0_client_secret, scim0_client_secret"/>
                <entry key="pageSize" value="100"/>
                <entry key="ips0_authType" value="Basic"/>
                <entry key="relaxConfiguration" value="true"/>
                <entry key="formPath" value="AribaAttributesForm.xhtml"/>
                <entry key="provisionMultivaluedRFCCompatible" value="true"/>
                <entry key="includeExtendedSchemaUrnInSchemasList">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry>
                <entry key="initialOffset" value="0"/>
                <entry key="updateGroupsViaUsers">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry>
                <entry key="managedDisabledAccounts">
                    <value>
                        <Boolean>false</Boolean>
                    </value>
                </entry>
                <entry key="realmType" value="Parent"/>
            </Map>
        </Attributes>
        <Schemas>
            <Schema displayAttribute="User Name" identityAttribute="ID" instanceAttribute=""
                    nativeObjectType="User" objectType="account">
                <AttributeDefinition internalName="id" name="ID" type="string">
                    <Description>A unique identifier for the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="userUuid" name="Global UUID" type="string">
                    <Description>The user's global uuid</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="active" name="Active" type="string">
                    <Description>The user's active status</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="userName" name="User Name" type="string">
                    <Description>The user's login name or user name</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="displayName" name="Display Name" type="string">
                    <Description>The user's display name</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="emails.value" name="Email" type="string">
                    <Description>The user's work email address</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="manager.value" name="Manager ID" type="string">
                    <Description>The user's primary supervisor username</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="passwordAdapter" name="Type" type="string">
                    <Description>The user's type (PasswordAdapter1 = Enterprise User and ThirdPartyUser = Third Party User)</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="phoneNumbers.work.primary.value" name="Business Phone Number"
                                     type="string">
                    <Description>The user's work Phone Number</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="phoneNumbers.fax.primary.value" name="Business Fax Number"
                                     type="string">
                    <Description>The user's fax Number</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="locale" name="Locale" type="string">
                    <Description>The user's locale</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="currency" name="Default Currency" type="string">
                    <Description>The user's currency</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="timezone" name="Timezone" type="string">
                    <Description>The user's timezone</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="deliverTo" name="Deliver To" type="string">
                    <Description>The user's Delivery Location</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="purchasingUnit" name="Purchasing Unit ID" type="string">
                    <Description>Purchasing Unit associated to the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="addresses.ShippingAddress.value" name="Shipping Address"
                                     type="string">
                    <Description>The user's Shipping Address detail</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="addresses.BillingAddress.value" name="Billing Address" type="string">
                    <Description>The user's Billing Address detail</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="companyCode.primary.displayId" name="Company Code ID" type="string">
                    <Description>The user's company code 'display id'</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="purchasingOrganization.primary.displayId"
                                     name="Purchasing Organization ID"
                                     type="string">
                    <Description>The user's purchasing organization 'display id'</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="purchasingGroup.primary.displayId" name="Purchasing Group ID"
                                     type="string">
                    <Description>The user's purchasing group 'display id'</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="generalLedgerAccount.primary.companyCodeId" name="General Ledger Company Code ID"
                                     type="string">
                    <Description>The user's general ledger account's company code id</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="generalLedgerAccount.primary.displayId"
                                     name="General Ledger Account ID"
                                     type="string">
                    <Description>The user's general ledger account 'display id'</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="costCenter.primary.companyCodeId" name="Cost Center Company Code ID"
                                     type="string">
                    <Description>The user's assigned cost center company code Id</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="costCenter.primary.costCenterId" name="Cost Center ID" type="string">
                    <Description>The user's cost center id</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="plant.primary.displayId" name="Plant ID" type="string">
                    <Description>The user's plant id 'display id'</Description>
                </AttributeDefinition>
                <AttributeDefinition entitlement="true" internalName="groups" managed="true" multi="true" name="Groups"
                                     schemaObjectType="group" type="string">
                    <Description>Groups linked to the user</Description>
                </AttributeDefinition>
            </Schema>
            <Schema descriptionAttribute="" displayAttribute="Group Name" identityAttribute="ID"
                    instanceAttribute="" nativeObjectType="group" objectType="group">
                <AttributeDefinition internalName="id" name="ID" type="string">
                    <Description>A unique identifier for the group</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="displayName" name="Group Name" required="true" type="string">
                    <Description>The group's name</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="members.user.value" multi="true" name="Members" type="string">
                    <Description>The members of the group</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="members.group.value" multi="true" name="Child Groups" type="string">
                    <Description>The child groups of the group</Description>
                </AttributeDefinition>
            </Schema>
        </Schemas>
        <Templates>
            <Template name="Create" schemaObjectType="account" usage="Create">
                <Field displayName="con_prov_policy_user_create_ariba_user_name"
                       helpKey="help_con_prov_policy_user_create_ariba_user_name" name="User Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_display_name"
                       helpKey="help_con_prov_policy_user_create_ariba_display_name" name="Display Name"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_emails"
                       helpKey="help_con_prov_policy_user_create_ariba_emails" name="Email"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_manager_id"
                       helpKey="help_con_prov_policy_user_create_ariba_manager_id" name="Manager ID"
                       required="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_userType"
                       helpKey="help_con_prov_policy_user_create_ariba_userType" name="Type"
                       required="true" type="string">
                    <AllowedValuesDefinition>
                        <Value>
                            <List>
                                <String>PasswordAdapter1</String>
                                <String>ThirdPartyUser</String>
                            </List>
                        </Value>
                    </AllowedValuesDefinition>
                </Field>
                <Field displayName="con_prov_policy_user_create_global_uuid"
                       helpKey="help_con_prov_policy_user_create_global_uuid" name="Global UUID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_phone_number"
                       helpKey="help_con_prov_policy_user_create_ariba_phone_number" name="Business Phone Number"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_ariba_fax_number"
                       helpKey="help_con_prov_policy_user_create_ariba_fax_number" name="Business Fax Number"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_locale"
                       helpKey="help_con_prov_policy_user_create_locale" name="Locale"
                       reviewRequired="true" type="string" value="en"/>
                <Field displayName="con_prov_policy_user_create_default_currency"
                       helpKey="help_con_prov_policy_user_create_default_currency" name="Default Currency"
                       reviewRequired="true" type="string" value="USD"/>
                <Field displayName="con_prov_policy_user_create_ariba_timezone"
                       helpKey="help_con_prov_policy_user_create_ariba_timezone" name="Timezone"
                       reviewRequired="true" type="string" value="America/Los_Angeles"/>
                <Field displayName="con_prov_policy_user_create_deliver_to"
                       helpKey="help_con_prov_policy_user_create_deliver_to" name="Deliver To"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_purchasing_unit"
                       helpKey="help_con_prov_policy_user_create_purchasing_unit" name="Purchasing Unit ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_shipping_address"
                       helpKey="help_con_prov_policy_user_create_shipping_address" name="Shipping Address"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_billing_address"
                       helpKey="help_con_prov_policy_user_create_billing_address" name="Billing Address"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_company_code_id"
                       helpKey="help_con_prov_policy_user_create_company_code_id" name="Company Code ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_purchasing_org_id"
                       helpKey="help_con_prov_policy_user_create_purchasing_org_id" name="Purchasing Organization ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_purchasing_group_id"
                       helpKey="help_con_prov_policy_user_create_purchasing_group_id" name="Purchasing Group ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_gl_company_code_id"
                       helpKey="help_con_prov_policy_user_create_gl_company_code_id" name="General Ledger Company Code ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_gl_account_id"
                       helpKey="help_con_prov_policy_user_create_gl_account_id" name="General Ledger Account ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_cost_center_company_code_id"
                       helpKey="help_con_prov_policy_user_create_cost_center_company_code_id"
                       name="Cost Center Company Code ID"
                       reviewRequired="true" type="string"/>
                <Field displayName="con_prov_policy_user_create_cost_center_id"
                       helpKey="help_con_prov_policy_user_create_cost_center_id" name="Cost Center ID"
                       reviewRequired="true" type="string"/>
            </Template>
        </Templates>
        <Settings><![CDATA[<?xml version='1.0' encoding='UTF-8'?>
