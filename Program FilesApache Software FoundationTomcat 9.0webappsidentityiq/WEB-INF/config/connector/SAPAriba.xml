<Form xmlns='http://www.sailpoint.com/xsd/sailpoint_form_2_0.xsd'
      name='SAP Ariba' connectorName="SAP Ariba"
      shortDesc="con_form_ariba_connection_settings" type="SourceConfig" directConnect="true" status="deprecated" fileUpload="false">

    <!-- SAP IPS Connection Settings -->
    <Menu name="SAP IPS Connection Settings" label="con_form_sac_ariba_connection_settings">
        <Section name="SAP IPS Connection Settings" label="con_form_sac_ariba_connection_settings"
                 sectionInfo="sectionInfo_AuthenticationSettings" docLinkLabel="docLinkLabel_AuthenticationSettings"
                 docLink="https://documentation.sailpoint.com/connectors/sap/ariba/help/">
            <Field name="ips0_host" displayName="con_form_ariba_ips_proxy_host" helpKey="help_con_form_ariba_ips_proxy_host" type="url" required="true" />
            <Field name="ips0_proxySystemId" displayName="con_form_ariba_ips_proxy_system_id" helpKey="help_con_form_ariba_ips_proxy_system_id" type="text" required="true"/>
            <Field name="ips0_user" displayName="con_form_ariba_ips_client_id" helpKey="help_con_form_ariba_ips_client_id" type="text" required="true"/>
            <Field name="ips0_password" displayName="con_form_ariba_ips_client_secret" helpKey="help_con_form_ariba_ips_client_secret" type="secret" required="true"/>
        </Section>
    </Menu>

    <!-- Realm Setting -->
    <Menu name="Realm Setting" label="con_form_sac_ariba_realmtype_settings">
        <Section name="Realm Setting" label="con_form_sac_ariba_realmtype_settings">
            <Field name="realmType" required="true" displayName="con_form_sap_ariba_type" type="radio" helpKey="con_help_sap_ariba_relam_type" defaultValue="Parent">
                <AllowedValues>
                    <Option label="con_form_sap_ariba_parent_relam" value="Parent"/>
                    <Option label="con_form_sap_ariba_child_relam" value="Child"/>
                </AllowedValues>
            </Field>
            <Field name="isManagedGeneralInfo" displayName="con_form_sap_ariba_manage_general_info" helpKey="help_con_form_sap_ariba_manage_general_info"
             type="checkbox" parentKey="realmType" parentValue="Child" defaultValue="false" />
        </Section>
    </Menu>

    <!-- Aggregation Settings -->
    <Menu name="Aggregation Settings" label="con_form_ariba_aggregation_settings">
        <Section name="Aggregation Settings" label="con_form_ariba_aggregation_settings">
            <Field name="aggregationWithDirectApis" displayName="con_form_ariba_aggregate_accounts_with_direct_apis" helpKey="help_con_form_ariba_aggregate_accounts_with_direct_apis"
                type="toggle"/>
        </Section>
    </Menu>
    <!-- SCIM Endpoint Configuration -->
    <Menu name="SCIM Endpoint Configuration" label="con_form_ariba_scim_api_settings" parentKey="aggregationWithDirectApis" parentValue="true" >
        <Section name="SCIM Endpoint Configuration" label="con_form_ariba_scim_api_settings">
            <Field name="scim0_authType" required="true" displayName="con_form_ariba_scim_authentication_method" type="select" defaultValue="OAuth2Login" helpKey="help_con_form_ariba_scim_authentication_method">
                <AllowedValues>
                    <Option label="oauth_2" value="OAuth2Login" />
                </AllowedValues>
            </Field>
            <Field name="scim0_grant_type" type="select" required="true" defaultValue="client_credentials" displayName="con_form_ariba_scim_grant_type" helpKey="help_con_form_ariba_scim_grant_type" >
                <AllowedValues>
                    <Option value="client_credentials" label="readonly_grant_type"/>
                </AllowedValues>
            </Field>
            <Field name="scim0_host" type="text" required="true" displayName="con_form_ariba_scim_application_url" helpKey="help_con_form_ariba_scim_application_url"/>
            <Field name="scim0_token_url" type="text" required="true" displayName="con_form_ariba_scim_token_url" helpKey="help_con_form_ariba_scim_token_url"/>
            <Field name="scim0_apiKey" type="text" required="true" displayName="con_form_ariba_scim_api_key" helpKey="help_con_form_ariba_scim_api_key"/>
            <Field name="scim0_anId" type="text" required="true" displayName="con_form_ariba_scim_an_id" helpKey="help_con_form_ariba_scim_an_id"/>
            <Field name="scim0_client_id" type="text" required="true" displayName="con_form_ariba_scim_client_id" helpKey="help_con_form_ariba_scim_client_id"/>
            <Field name="scim0_client_secret" type="secret" required="true" displayName="con_form_ariba_scim_client_secret" helpKey="help_con_form_ariba_scim_client_secret"/>
        </Section>
    </Menu>

    <!-- Page size settings -->
    <Menu name="Page Size Settings" label="con_form_ariba_page_size_settings">
        <Section name="Page Size Settings" label="con_form_ariba_page_size_settings" sectionInfo="sectionInfo_pageSizeSettings">
            <Field name="pageSize" displayName="con_form_ariba_page_size" helpKey="help_con_form_ariba_page_size_settings" type="number" saveAsString="true" defaultValue="100" min="1" max="100"/>
        </Section>
    </Menu>

</Form>]]>
        </Settings>
    </Application>
</ImportAction>
