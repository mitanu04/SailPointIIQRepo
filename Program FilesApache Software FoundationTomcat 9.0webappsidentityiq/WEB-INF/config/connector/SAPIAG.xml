<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ImportAction PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<ImportAction name="connectorRegistryUpdateAction">
    <Application connector="sailpoint.connector.OpenConnectorAdapter"
                 featuresString="PROVISIONING, SYNC_PROVISIONING" icon="internetIcon" name="SAP IAG"
                 type="SAP IAG">
        <Attributes>
            <Map>
                <entry key="connectorClass" value="openconnector.connector.sapiag.SAPIAGConnector"/>
                <entry key="encrypted" value="rest0_client_secret, oauth_token_info"/>
                <entry key="pageSize" value="500"/>
                <entry key="provisioningStatusCheckInterval" value="60"/>
                <entry key="formPath" value="SAPIAGAttributes.xhtml"/>
                <entry key="relaxConfiguration" value="true"/>
                <entry key="accountType" value="Sub-Account"/>
                <entry key="isAttributeReqSplit" value="true"/>
                <entry key="splitAttributeRequestNames">
                    <value>
                        <List>
                            <String>Access</String>
                        </List>
                    </value>
                </entry>
            </Map>
        </Attributes>
        <Schemas>
            <Schema displayAttribute="User ID" identityAttribute="User ID" nativeObjectType="User" objectType="account">
                <AttributeDefinition internalName="id" name="User ID" type="string">
                    <Description>A unique identifier for the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="firstName" name="First Name" type="string">
                    <Description>First name of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="lastName" name="Last Name" type="string">
                    <Description>Last name of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="displayName" name="Display Name" type="string">
                    <Description>Display name of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="email" name="Email" type="string">
                    <Description>Email of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="userLocation" name="Location" type="string">
                    <Description>Location of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="managerUserId" name="Manager ID" type="string">
                    <Description>Manager ID of the user</Description>
                </AttributeDefinition>
                <AttributeDefinition entitlement="true" managed="true" multi="true"
                                     name="Access" schemaObjectType="group" type="string">
                    <Description>Access assigned to the user</Description>
                </AttributeDefinition>
            </Schema>
            <Schema displayAttribute="Display Name" identityAttribute="Access ID" objectType="group" nativeObjectType="group">
                <AttributeDefinition internalName="accessId" name="Access ID" type="string">
                    <Description>ID of the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="displayName" name="Display Name" type="string">
                    <Description>Display name of the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="accessDescription" name="Access Description" type="string">
                    <Description>Access description</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="accessType" name="Access Type" type="string">
                    <Description>Type of the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="accessTypeDescription" name="Access Type Description" type="string">
                    <Description>Access type description</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="applicationType" name="Application Type" type="string">
                    <Description>Application type of the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="applicationTypeDescription" name="Application Type Description" type="string">
                    <Description>Application type description</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="businessProcessId" name="Business Process ID" type="string">
                    <Description>Business process to which access belongs</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="businessProcessDescription" name="Business Process Description" type="string">
                    <Description>Business process description to which access belongs</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="businessSubProcessId" name="Sub Business Process ID" type="string">
                    <Description>Sub business process to which access belongs</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="actionName" name="Action" type="string">
                    <Description>Action name associated with the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="criticalityName" name="Criticality Name" type="string">
                    <Description>Criticality name associated with the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="criticalityNameId" name="Criticality ID" type="string">
                    <Description>Criticality name id associated with the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="remainingDays" name="Remaining Days" type="string">
                    <Description>Remaining days of the access</Description>
                </AttributeDefinition>
                <AttributeDefinition internalName="accessAlias" name="Access Alias Name" type="string">
                    <Description>Alias name of the access</Description>
                </AttributeDefinition>
            </Schema>
        </Schemas>
    </Application>
</ImportAction>