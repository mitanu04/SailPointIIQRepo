  <Configuration name="AccessHistoryConfiguration">
    <Attributes>
      <Map>
        <!-- The format of Access History JSON columns (either PRETTY, MINIFIED, or ZIPPED). -->
        <!-- ZIPPED Option will only be applied to HistoricalCapture. -->
        <!-- If ZIPPED is selected Access History non-HistoricalCaptures are stored MINIFIED. -->
        <entry key="jsonFormat" value="ZIPPED" />

        <!-- must have a value if patch documents will be allowed -->
        <entry key="maxAllowedPatchDocuments" value="4" />

        <entry key="captureMaxAgeInDays" value="30" />

        <!-- determines whether a non-interesting change on a object will cause a new capture to be saved or not-->
        <entry key="saveNonInterestingChanges" value="false" />
      </Map>
    </Attributes>
