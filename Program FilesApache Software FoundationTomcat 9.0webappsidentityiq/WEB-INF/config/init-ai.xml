<!--
  Initialization file for SailPoint AI-Driven Identity Security integration with IdentityIQ.
-->
<sailpoint>

    <!--  Rights and Capabilities -->
    <ImportAction name="include" value="WEB-INF/config/ai/authorization-ai.xml"/>

    <!--
  Declare the AI-Driven Identity Security module
    -->
    <Module name="AIDrivenIdentitySecurity" description="ui_identityai_module_desc">
        <Attributes>
            <Map>
                <entry key="healthCheckClass" value="sailpoint.identityai.IdentityAIHealthChecker"/>
                <entry key="enabledConfigKey" value="identityAIEnabled"/>
            </Map>
        </Attributes>
    </Module>

    <!--
  By setting IdentityAIEnabled, we enable the configuration and use of AI-Driven Identity Security.

  By setting recommenderSelected, IdentityIQ will use the recommender
  defined by the RecommenderDefinition named "AI-Driven Identity Security", which
  is loaded by the plugin.

  If lcmEnableApprovalRecommendations is true, then LCM workflows will calculate
  recommendations for approvals, assuming that a recommender
  like AI-Driven Identity Security is properly configured.

  If certificationShowRecommendations is true, the default behavior is for
  certifications to generate and show recommendations. This can be overridden on
  a per-certification basis at creation or during Staging phase
    -->
    <ImportAction name="merge">
        <Configuration name="SystemConfiguration">
            <Attributes>
                <Map>
                    <entry key="identityAIEnabled" value="true" />
                    <entry key="recommenderSelected" value="AIDrivenIdentitySecurity" />
                    <entry key="lcmEnableApprovalRecommendations" value="true" />
                    <entry key="certificationShowRecommendations" value="true" />
                    <entry key="allowRecommendedAccess" value="true" />
                </Map>
            </Attributes>
        </Configuration>
    </ImportAction>

    <ImportAction name="installPlugin" value="plugins/identityai-recommender-plugin.zip" >
        <Attributes>
            <Map>
                <entry key="throwOnError" value="true"/>
                <entry key="ignoreEqualVersion" value="true"/>
            </Map>
        </Attributes>
    </ImportAction>

    <ImportAction name='execute' value='sailpoint.identityai.IdentityAIMonitoringConfigUpdater'/>

    <Configuration name='IdentityAIConfiguration'>
        <Attributes>
            <Map>
                <entry key="readTimeoutSeconds" value="60" />
                <entry key="connectTimeoutSeconds" value="10" />
                <entry key="minNumIdentitiesRole" value="20" />
                <entry key="catalogCacheTTLMillis" value="86400000" />
                <entry key="recommendationsEndpoint" value="beta/recommendations/request" />
                <entry key="recommendationsCatalogEndpoint" value="beta/translation-catalogs/recommender" />
            </Map>
        </Attributes>
    </Configuration>

    <Configuration name='GenAIConfiguration'>
        <Attributes>
            <Map>
                <entry key="readTimeoutSeconds" value="60" />
                <entry key="connectTimeoutSeconds" value="10" />
                <entry key="genAIEntitlementDescriptionsPollInterval" value="30"/>
                <entry key="genAIEntitlementApprovalCheckBox" value="true"/>
                <entry key="genAIPromptsPerApiRequestBatchSize" value="10"/>
                <entry key="genAIEntitlementDescriptionsPromptName" value="genai-descriptions-iiq"/>
                <entry key="genAIAsyncRequestEndpoint" value="v2024/genai-gateway/llm-batch-completions" />
                <entry key="genAIAsyncRequestPromptArtifactEndpoint" value="v2024/genai-gateway/prompts/%s/artifacts" />
            </Map>
        </Attributes>
    </Configuration>

    <Identity name="AIDrivenIdentitySecurity" protected="true" workgroup="true">
        <Attributes>
            <Map>
                <entry key="displayName" value="AI-Driven Identity Security"/>
                <entry key="systemUser">
                    <value>
                        <Boolean>true</Boolean>
                    </value>
                </entry>
            </Map>
        </Attributes>
    </Identity>

