                                                        <String>iiqLocked</String>
                                                    </List>
                                                </value>
                                            </entry>
                                        </Map>
                                    </value>
                                </entry>
                                <entry key="sailpoint.object.ManagedAttribute">
                                    <value>
                                        <Map>
                                            <entry key="operations">
                                                <value>
                                                    <Set>
                                                        <String>TYPE_DELETE</String>
