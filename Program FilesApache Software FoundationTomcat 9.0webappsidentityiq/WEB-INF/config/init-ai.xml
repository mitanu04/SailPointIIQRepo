    </ImportAction>

    <!--
    This Index is used to store data from AsyncRequest table and displayName, application from ManagedAttribute table.
    Data fetched from this index is used in GenAI Entitlement Progress page where searching is applied on displayName, suggestedDescription
    and all columns in this page are sortable.
    -->
    <FullTextIndex name="GAIEDAsyncRequest">
        <Attributes>
            <Map>
                <entry key="fields">
                    <value>
                        <List>
                            <FullTextField name="id" indexed="true" />
                            <FullTextField name="application" indexed="true"/>
                            <FullTextField name="displayName" indexed="true" analyzed="true" />
                            <FullTextField name="suggestedDescription" indexed="true" analyzed="true"/>
                            <FullTextField name="status" indexed="true"/>
                            <FullTextField name="creationDate" indexed="true"/>
                            <FullTextField name="reference" indexed="true" />
                            <FullTextField name="sortableApplication" indexed="true" />
                            <FullTextField name="sortableDisplayName" indexed="true" />
                            <FullTextField name="sortableDescription" indexed="true" />
                            <FullTextField name="sortableStatus" indexed="true" />
                            <FullTextField name="sortableCreationDate" indexed="true" />
                        </List>
                    </value>
                </entry>
                <entry key='analyzer' value='sailpoint.fulltext.NGramAnalyzer'/>
            </Map>
        </Attributes>
    </FullTextIndex>

    <ImportAction name='merge'>
        <UIConfig name='UIConfig'>
            <Attributes>
                <Map>
                    <entry key="debugAsyncRequestGridColumns">
                        <value>
                            <List>
                                <ColumnConfig dataIndex="id" groupProperty="id" headerKey="Id" property="id" sortProperty="id" sortable="true" stateId="id" width="250"/>
                                <ColumnConfig dataIndex="referenceType" groupProperty="referenceType" headerKey="Reference Type" property="referenceType" sortProperty="referenceType" sortable="true" stateId="referenceType" width="150"/>
                                <ColumnConfig dataIndex="reference" groupProperty="reference" headerKey="Reference" property="reference" sortProperty="reference" sortable="true" stateId="reference" width="150"/>
                                <ColumnConfig dataIndex="result"    groupProperty="result"    headerKey="Result"    property="result"    sortProperty="result"    sortable="true" stateId="result"    width="200" />
                                <ColumnConfig dataIndex="status" groupProperty="status" headerKey="Status"  property="status" sortProperty="status" sortable="true"  stateId="status" width="120" />
                                <ColumnConfig dataIndex="created" groupProperty="created" headerKey="Created" dateStyle="short" property="created" sortProperty="created" sortable="true" stateId="created" width="150" />
                                <ColumnConfig dataIndex="modified" groupProperty="modified" headerKey="Modified" dateStyle="short" property="modified" sortProperty="modified" sortable="true" stateId="modified" width="150" />
                            </List>
                        </value>
                    </entry>
                    <entry key="debugAsyncRequestSearchProperties" value="id,referenceType,reference,result,status" />
                    <entry key="genAiEntitlementDescriptionTableColumns">
                        <value>
                            <List>
                                <ColumnConfig headerKey="application" dataIndex="application" property="application" sortProperty="application" sortable="true" hideable="true" percentWidth="12" resizable="true"/>
                                <ColumnConfig headerKey="displayName" dataIndex="displayName" property="displayName" sortProperty="displayName" sortable="true" hideable="true" percentWidth="12" resizable="true"/>
                                <ColumnConfig headerKey="suggestedDescription" dataIndex="suggestedDescription" property="suggestedDescription" sortProperty="suggestedDescription" sortable="true" hideable="true" percentWidth="38" renderer="spEntitlementSuggestedDescription" resizable="true"/>
                                <ColumnConfig headerKey="creationDate" dataIndex="creationDate" property="creationDate" sortProperty="creationDate" sortable="true" hideable="true" percentWidth="12" renderer="spEntitlementCreationDate" resizable="true" dateStyle="short"/>
                                <ColumnConfig headerKey="status" dataIndex="status" property="status" sortable="true" hideable="true" percentWidth="12" renderer="spEntitlementRequestStatus"/>
                                <ColumnConfig headerKey="actions" dataIndex="actions" property="actions" sortable="false" hideable="false" percentWidth="14" renderer="spEntitlementAction" fixed="Right"/>
                            </List>
                        </value>
                    </entry>
                </Map>
            </Attributes>
        </UIConfig>
    </ImportAction>

    <!--***********************************************************
    Services
    *************************************************************-->
    <ServiceDefinition name="AsyncRequestProcessor" hosts='global' interval='60'>
        <Description>
            Service definition for the async request service
        </Description>
        <Attributes>
            <Map>
                <entry key="lockTimeout">
                    <value>
                        <Integer>300</Integer>
                    </value>
                </entry>
                <entry key="cycleSeconds">
                    <value>
                        <Integer>10</Integer>
                    </value>
                </entry>
            </Map>
        </Attributes>
    </ServiceDefinition>

</sailpoint>
